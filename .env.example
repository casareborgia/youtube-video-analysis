# ==========================================
# TubeInsight AI & Agent Luna 환경설정 템플릿
# ==========================================
# 이 파일을 복사하여 .env 파일을 생성한 뒤, 필요한 키를 입력하세요:
#   cp .env.example .env
# 또는 웹 UI 우측 상단의 [⚙️ API 키 & 시스템 환경설정] 모달에서 직접 입력할 수 있습니다.

# 1. Google Gemini API 키 (선택, 이미지/영상/음악 생성용)
# 발급처: https://aistudio.google.com/
# 기능: 나노바나나(Imagen) 앨범아트, Omni 1.1 영상, Lyria 3 Pro 음악 생성
# * 미설치/미입력 시에도 로컬 LLM(Ollama / LM Studio)과 ffmpeg 신디사이저로 전 기능 안전하게 폴백 동작합니다.
GEMINI_API_KEY=

# 2. 로컬 LLM 엔드포인트 설정 (선택, 기본값 자동 감지)
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# 3. 미디어 저장 디렉터리 설정 (기본값)
AUDIO_DIR=./data/audio
VIDEO_DIR=./data/video
ASSETS_DIR=./assets

# 4. YouTube Data API v3 OAuth (선택, 채널 관리 및 자동 업로드)
# Google Cloud Console에서 데스크톱 OAuth 클라이언트를 생성하고,
# 내려받은 client_secret_*.json 파일을 아래 위치에 배치하세요:
#   data/youtube/client_secret.json
# (웹 UI [환경설정] 모달에서 배치 여부가 자동 감지됩니다)

# 5. Meta Threads API 설정 (선택, OSMU 스레드 자동 발행)
# THREADS_USER_ID=
# THREADS_ACCESS_TOKEN=
